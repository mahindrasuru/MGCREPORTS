                    <TablixCell>
                      <CellContents>
                        <Textbox Name="saleitem_srno">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!saleitem_cnno.value &gt; 0, IIf(Format(Fields!consignment_bookingdate.Value,"dd/MM/yyyy")="31/12/2999",0, RowNumber("sale_id")),0)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0;(0);''</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
