<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>MGC</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>MGC</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>MGC</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSource Include="dsMarutiCargo.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="cashcollectionvoucher.rdl" />
    <Report Include="cashcollectionvoucher_a4_p_1.rdl" />
    <Report Include="cashcollection_a4_l_1.rdl" />
    <Report Include="cashcollection_a4_l_2.rdl" />
    <Report Include="cashcollection_a4_l_3.rdl" />
    <Report Include="cashcollection_a4_l_4.rdl" />
    <Report Include="csr_console_brief_a4.rdl" />
    <Report Include="csr_console_detail_a4_l.rdl" />
    <Report Include="csr_console_detail_a4_l_2.rdl" />
    <Report Include="csr_console_insurance_a4.rdl" />
    <Report Include="csr_console_load.rdl" />
    <Report Include="csr_nonbilled_a4_l_1.rdl" />
    <Report Include="invoice_console_a4_port_bp3.rdl" />
    <Report Include="invoice_console_a4_port_bp3_batch.rdl" />
    <Report Include="invoice_console_a4_port_bp3_batch2.rdl" />
    <Report Include="invoice_console_a4_port_bp4.rdl" />
    <Report Include="invoice_console_a4_port_bp5.rdl" />
    <Report Include="invoice_console_a4_port_cash.rdl" />
    <Report Include="print_consolecn.rdl" />
    <Report Include="print_consolecn2.rdl" />
    <Report Include="print_consolecn3.rdl" />
    <Report Include="saleregister_a4_l.rdl" />
    <Report Include="saleregister_detail_l.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>